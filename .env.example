# Database
DB_USER=backend
DB_PASSWORD=LOL/A  # <-- 特殊字元現在可以直接使用
DB_HOST=db
DB_PORT=5432
DB_NAME=magic_pinecone_db

# Server URL for OpenAPI Docs
BACKEND_URL=http://localhost:8000


# NCU Portal OAuth
NCU_OAUTH_CLIENT_ID=your_client_id
NCU_OAUTH_CLIENT_SECRET=your_client_secret
NCU_OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback
ALLOWED_REDIRECT_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:18080

# JWT Security
JWT_SECRET_KEY=generate_a_secure_random_string_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440



